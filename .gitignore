__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.env

# Immutable captures and generated ledgers stay runtime data.
# Raw bodies and tar.gz bundles are NEVER committed (they live in
# Actions artifacts with 30-day retention).
data/raw/*
data/interim/*
data/ledgers/*
data/reports/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/ledgers/.gitkeep
!data/reports/.gitkeep

# Shadow evidence git policy (owner amendment 2026-09-03):
!data/reports/capture_*.json
!data/reports/shadow/
data/reports/shadow/**/raw_bodies/*
data/reports/shadow/**/*.tar.gz

# Settlement evidence: commit receipts, exclude raw capture bodies.
data/settlement_evidence/*
!data/settlement_evidence/.gitkeep
!data/settlement_evidence/**/settlement_capture_receipt.json

# Trained artifacts are generated from frozen ledgers.
models/
