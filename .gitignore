__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.env

# Immutable captures and generated ledgers stay runtime data.
data/raw/*
data/interim/*
data/ledgers/*
data/reports/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/ledgers/.gitkeep
!data/reports/.gitkeep

# Settlement evidence: commit receipts, exclude raw capture bodies.
data/settlement_evidence/*
!data/settlement_evidence/.gitkeep
!data/settlement_evidence/**/settlement_capture_receipt.json

# Trained artifacts are generated from frozen ledgers.
models/
